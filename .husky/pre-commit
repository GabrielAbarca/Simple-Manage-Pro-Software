#!/usr/bin/env sh

# Block commits authored as Claude. The sandbox's global ~/.gitconfig sets
# user.name=Claude / user.email=noreply@anthropic.com, so a commit with a
# perfectly clean message still lands in GitHub's contributor list as Claude
# unless the repo-local identity is set. See hard rule 3 in CLAUDE.md.
author_name=$(git config user.name)
author_email=$(git config user.email)

case "$author_name$author_email" in
*[Cc]laude* | *anthropic* | *noreply@anthropic.com*)
  echo ""
  echo "  COMMIT BLOCKED — author is \"$author_name <$author_email>\""
  echo ""
  echo "  This repo's commits are authored by the repository owner only."
  echo "  Set the repo-local identity, then commit again:"
  echo ""
  echo "    git config user.name \"Gabriel Zelaya\""
  echo "    git config user.email \"gzelaya0404@gmail.com\""
  echo ""
  exit 1
  ;;
esac

npx lint-staged
