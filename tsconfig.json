{
  // Type-checking only (noEmit) for a plain-JS codebase via `checkJs` + JSDoc.
  // Vite builds the code with esbuild; this config exists purely for the
  // `npm run typecheck` gate and editor IntelliSense.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Pragmatic strictness for incremental JS typing: still catches unknown
    // properties, wrong argument counts and type mismatches, without drowning
    // in implicit-any / DOM-null noise. Tighten as JSDoc coverage grows.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/js/**/*.js"],
  // Screens that already pass the checker; listed so the screens glob below
  // doesn't drop them.
  "files": [
    "src/js/student/screens/conduct.js",
    "src/js/student/screens/helpers.js",
    "src/js/teacher/screens/classExports.js",
    "src/js/teacher/screens/conductTables.js",
    "src/js/teacher/screens/postConduct.js"
  ],
  // Page entries, navs and screens are DOM glue, typed incrementally. TS still
  // checks an excluded file when a checked file imports it, so the entries
  // stay excluded to keep the screens they import out of the checked set.
  "exclude": [
    "src/js/admin.js",
    "src/js/teacher.js",
    "src/js/student.js",
    "src/js/login.js",
    "src/js/admin/**",
    "src/js/*/nav.js",
    "src/js/*/screens/**",
    "node_modules",
    "dist"
  ]
}
