{
  // Type-checking only (noEmit) for a plain-JS codebase via `checkJs` + JSDoc.
  // Vite builds the code with esbuild; this config exists purely for the
  // `npm run typecheck` gate and editor IntelliSense.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Pragmatic strictness for incremental JS typing: still catches unknown
    // properties, wrong argument counts and type mismatches, without drowning
    // in implicit-any / DOM-null noise. Tighten as JSDoc coverage grows.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/js/**/*.js"],
  // The large view-controllers are DOM-glue and typed incrementally in a
  // later pass; the reusable logic layer (queries, demo DB, i18n, …) is checked.
  // src/js/main.js is now a thin orchestrator (session bootstrap + wiring),
  // but TS still walks a root file's imports and type-checks them even when
  // those imported files are themselves excluded — so main.js has to stay
  // excluded too, or importing the DOM-glue view modules below would pull
  // them back into the checked set. studentState.js/studentAuth.js/
  // views/viewHelpers.js aren't affected: they're matched by the "include"
  // glob directly and checked as their own root files regardless.
  "exclude": [
    "src/js/admin.js",
    "src/js/teacher.js",
    "src/js/main.js",
    "src/js/login.js",
    "src/js/studentNav.js",
    "src/js/views/dashboard.js",
    "src/js/views/grades.js",
    "src/js/views/schedule.js",
    "src/js/views/teachers.js",
    "src/js/views/attendance.js",
    "src/js/views/events.js",
    "src/js/views/settingsView.js",
    "src/js/teacherNav.js",
    "src/js/teacherFeedback.js",
    "src/js/teacherModal.js",
    "src/js/teacherData/index.js",
    "src/js/views/teacherToday.js",
    "src/js/views/myClasses.js",
    "src/js/views/classWorkspace.js",
    "src/js/views/roster.js",
    "src/js/views/studentForm.js",
    "src/js/views/studentDrawer.js",
    "src/js/views/discipline.js",
    "src/js/views/progressReport.js",
    "src/js/views/gradebook.js",
    "src/js/views/assignments.js",
    "src/js/views/studentGrades.js",
    "src/js/views/categories.js",
    "src/js/views/postGrades.js",
    "src/js/views/columnGrades.js",
    "src/js/views/teacherAttendance.js",
    "src/js/views/teacherSchedule.js",
    "src/js/views/subjects.js",
    "src/js/views/teacherSettings.js",
    "node_modules",
    "dist"
  ]
}
