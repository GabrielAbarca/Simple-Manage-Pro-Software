{
  // Type-checking only (noEmit) for a plain-JS codebase via `checkJs` + JSDoc.
  // Vite builds the code with esbuild; this config exists purely for the
  // `npm run typecheck` gate and editor IntelliSense.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Pragmatic strictness for incremental JS typing: still catches unknown
    // properties, wrong argument counts and type mismatches, without drowning
    // in implicit-any / DOM-null noise. Tighten as JSDoc coverage grows.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/js/**/*.js"],
  // The large view-controllers are DOM-glue and typed incrementally in a
  // later pass; the reusable logic layer (queries, demo DB, i18n, …) is checked.
  // src/js/student.js is now a thin orchestrator (session bootstrap + wiring),
  // but TS still walks a root file's imports and type-checks them even when
  // those imported files are themselves excluded — so student.js has to stay
  // excluded too, or importing the DOM-glue view modules below would pull
  // them back into the checked set. student/state.js, student/auth.js and
  // student/screens/helpers.js aren't affected: they're matched by the
  // "include" glob directly and checked as their own root files regardless.
  "exclude": [
    "src/js/admin.js",
    // The admin console's modules (src/js/admin/**) are DOM glue, split out of
    // admin.js and excluded for the same reason it is. The glob deliberately
    // does NOT match src/js/adminData.js or src/js/adminDemoDb.js — those are
    // the checked logic layer and live at the flat top level.
    "src/js/admin/**",
    "src/js/teacher.js",
    "src/js/student.js",
    "src/js/login.js",
    "src/js/student/nav.js",
    "src/js/student/screens/dashboard.js",
    "src/js/student/screens/grades.js",
    "src/js/student/screens/schedule.js",
    "src/js/student/screens/teachers.js",
    "src/js/student/screens/attendance.js",
    "src/js/student/screens/events.js",
    "src/js/student/screens/settings.js",
    "src/js/teacher/nav.js",
    "src/js/teacher/data/index.js",
    "src/js/teacher/screens/today.js",
    "src/js/teacher/screens/myClasses.js",
    "src/js/teacher/screens/classWorkspace.js",
    "src/js/teacher/screens/roster.js",
    "src/js/teacher/screens/studentForm.js",
    "src/js/teacher/screens/studentDrawer.js",
    "src/js/teacher/screens/discipline.js",
    "src/js/teacher/screens/progressReport.js",
    "src/js/teacher/screens/gradebook.js",
    "src/js/teacher/screens/assignments.js",
    "src/js/teacher/screens/studentGrades.js",
    "src/js/teacher/screens/categories.js",
    "src/js/teacher/screens/postGrades.js",
    "src/js/teacher/screens/columnGrades.js",
    "src/js/teacher/screens/attendance.js",
    "src/js/teacher/screens/schedule.js",
    "src/js/teacher/screens/subjects.js",
    "src/js/teacher/screens/settings.js",
    "node_modules",
    "dist",
    "src/js/teacher/screens/conduct.js"
  ]
}
